<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="kr.baeksuk.urlBox">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name="kr.baeksuk.urlbox.util.base.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_main"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_main_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinkBox"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name="kr.baeksuk.urlbox.view.imgdetail.ImgDetailActivity"
            android:exported="false" />
        <activity
            android:name="kr.baeksuk.urlbox.view.favorite.FavoritesActivity"
            android:exported="false" />
        <activity
            android:name="kr.baeksuk.urlbox.view.savedlink.SavedLinkActivity"
            android:exported="false" />
        <activity
            android:name="kr.baeksuk.urlbox.view.urldetail.UrlDetailActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="kr.baeksuk.urlBox.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="kr.baeksuk.urlbox.view.addlink.capture.CaptureActivity"
            android:exported="false" />
        <activity
            android:name="kr.baeksuk.urlbox.view.addlink.AddLinkActivity"
            android:exported="false" />
        <activity
            android:name="kr.baeksuk.urlbox.view.main.MainActivity"
            android:exported="false" />
        <activity
            android:name="kr.baeksuk.urlbox.view.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>