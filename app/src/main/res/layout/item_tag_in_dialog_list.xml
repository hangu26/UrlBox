<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/padding_end_item_tag"
    android:paddingBottom="@dimen/padding_end_item_tag">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_tag_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/border_url_tag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tx_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_tx_tag_in_dialog"
            android:layout_marginEnd="@dimen/margin_tx_tag_in_dialog"
            android:layout_marginTop="@dimen/margin_vertical_tx_tag_in_dialog"
            android:layout_marginBottom="@dimen/margin_vertical_tx_tag_in_dialog"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:text="nice"
            android:textColor="@color/color_stroke_url_tag"
            android:textSize="@dimen/tx_confirm_url_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>