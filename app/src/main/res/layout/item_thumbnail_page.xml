<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/url_detail_image_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_url"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/url_detail_img_margin"
            android:transitionName="imageTran"
            android:src="@drawable/urlbox_icon"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tx_url"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/url_detail_text_margin_top"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:paddingStart="@dimen/url_detail_text_margin_side"
            android:paddingEnd="@dimen/url_detail_text_margin_side"
            android:text="https://www.youtube.com/wersadfasdgwear"
            android:textSize="@dimen/url_detail_text_size"
            android:textColor="@color/tx_black"
            android:transitionName="titleTran"
            android:onClick="@{() -> viewmodel.btnLoadUrl()}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_url" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>