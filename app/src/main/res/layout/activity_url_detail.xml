<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="activity"
            type="kr.baeksuk.urlbox.view.urldetail.UrlDetailActivity" />

        <variable
            name="viewmodel"
            type="kr.baeksuk.urlbox.viewmodel.urldetail.UrlDetailViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_frag_info">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/white"
                app:contentInsetStart="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tx_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="@string/tx_url_detail"
                        android:textColor="@color/appBar_title_02"
                        android:textSize="@dimen/appbar_tx_title_chat"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/btn_close"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/img_setting_margin_end"
                        android:onClick="@{() -> viewmodel.btnClose()}"
                        android:src="@drawable/close_24px"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/icon_edit"
                        android:layout_width="@dimen/img_star_size"
                        android:layout_height="@dimen/img_star_size"
                        android:layout_marginEnd="15dp"
                        android:onClick="@{() -> viewmodel.btnEdit()}"
                        android:src="@drawable/icon_edit"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/icon_favorite"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/icon_favorite"
                        android:layout_width="@dimen/img_star_size"
                        android:layout_height="@dimen/img_star_size"
                        android:layout_marginEnd="15dp"
                        android:onClick="@{() -> viewmodel.btnFavorite()}"
                        android:src="@drawable/icon_favorite_app_color"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/appBarLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/appBarLayout">

                <ImageView
                    android:id="@+id/img_url"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/margin_side_img_url_detail"
                    android:layout_marginEnd="@dimen/margin_side_img_url_detail"
                    android:src="@drawable/urlbox_icon"
                    android:transitionName="imageTran"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="@dimen/margin_top_tap_info_memo"
                    android:background="@drawable/tab_background"
                    app:layout_constraintEnd_toEndOf="@+id/img_url"
                    app:layout_constraintStart_toStartOf="@+id/img_url"
                    app:layout_constraintTop_toBottomOf="@+id/img_url"
                    app:tabIndicator="@drawable/tab_indicator"
                    app:tabIndicatorAnimationMode="elastic"
                    app:tabIndicatorColor="@android:color/transparent"
                    app:tabIndicatorFullWidth="true"
                    app:tabIndicatorGravity="center"
                    app:tabIndicatorHeight="41dp"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabSelectedTextColor="@color/white"
                    app:tabTextColor="@color/appBar_title_02" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    app:layout_constraintBottom_toTopOf="@+id/linear_change_delete"
                    app:layout_constraintTop_toBottomOf="@+id/tab_layout" />

                <TextView
                    android:id="@+id/tx_url_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_url_name"
                    android:fontFamily="@font/pretendard_medium"
                    android:text="@string/tx_url_name"
                    android:textColor="@color/black"
                    android:textSize="@dimen/size_url_name_text"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@+id/img_url"
                    app:layout_constraintTop_toBottomOf="@+id/view_pager" />

                <LinearLayout
                    android:id="@+id/linear_change_delete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_vertical_linear_change_delete"
                    android:layout_marginBottom="@dimen/margin_vertical_linear_change_delete"
                    android:gravity="fill_horizontal"
                    android:orientation="vertical"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="@+id/img_url"
                    app:layout_constraintStart_toStartOf="@+id/img_url"
                    app:layout_constraintTop_toBottomOf="@+id/view_pager">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_visit"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_btn_in_url_detail_activity"
                        android:layout_gravity="start"
                        android:background="@drawable/border_btn_change_pic"
                        android:elevation="2dp"
                        android:onClick="@{() -> viewmodel.btnChangeImg()}"
                        android:translationZ="2dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/icon_url"
                                android:layout_width="@dimen/size_img_url"
                                android:layout_height="@dimen/size_img_url"
                                android:src="@drawable/icon_camera"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/tx_visit"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tx_visit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_img_url_to_tx_visit"
                                android:fontFamily="@font/pretendard_medium"
                                android:text="@string/tx_change_pic"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_btn_capture"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/icon_url"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/space_in_url_detail_activity" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_delete"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_btn_in_url_detail_activity"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/margin_bottom_btn_delete"
                        android:background="@drawable/border_btn_delete"
                        android:elevation="2dp"
                        android:onClick="@{() -> viewmodel.btnDelete()}"
                        android:translationZ="2dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">


                            <ImageView
                                android:id="@+id/icon_trash"
                                android:layout_width="@dimen/size_img_url"
                                android:layout_height="@dimen/size_img_url"
                                android:src="@drawable/icon_trash"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/tx_delete"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tx_delete"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_img_url_to_tx_visit"
                                android:fontFamily="@font/pretendard_medium"
                                android:text="@string/tx_delete"
                                android:textColor="@color/color_tx_delete"
                                android:textSize="@dimen/text_btn_capture"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/icon_trash"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>