<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="activity"
            type="kr.baeksuk.urlbox.view.editurl.EditInfoActivity" />

        <variable
            name="viewmodel"
            type="kr.baeksuk.urlbox.viewmodel.editurl.EditUrlViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/white"
                app:contentInsetStart="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tx_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="@string/tx_url_detail"
                        android:textColor="@color/appBar_title_02"
                        android:textSize="@dimen/appbar_tx_title_chat"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/btn_close"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/img_setting_margin_end"
                        android:src="@drawable/arrow_back_24px"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/appBarLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/appBarLayout">

                <ImageView
                    android:id="@+id/img_url"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/url_detail_img_margin"
                    android:layout_marginEnd="@dimen/url_detail_img_margin"
                    android:scaleType="centerCrop"
                    android:src="@drawable/urlbox_icon"
                    android:transitionName="imageTran"
                    app:layout_constraintDimensionRatio="1:0.6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/linear_change_img"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_linear_btn_edit_delete"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="@+id/tx_url_name_info"
                    app:layout_constraintStart_toStartOf="@+id/img_url"
                    app:layout_constraintTop_toBottomOf="@+id/img_url">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_capture"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_constraint_btn_recapture"
                        android:layout_gravity="start"
                        android:background="@drawable/border_btn_capture"
                        android:onClick="@{() -> viewmodel.btnChangeImg()}">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/icon_capture"
                                android:layout_width="@dimen/size_icon_camera"
                                android:layout_height="@dimen/size_icon_camera"
                                android:layout_marginEnd="@dimen/margin_icon_camera"
                                android:src="@drawable/icon_camera"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/tx_capture"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tx_capture"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pretendard_medium"
                                android:text="@string/tx_btn_capture"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_btn_capture"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/icon_capture"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_album"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_constraint_btn_recapture"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/margin_top_linear_btn_edit_delete"
                        android:background="@drawable/border_btn_delete">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/icon_album"
                                android:layout_width="@dimen/size_icon_album"
                                android:layout_height="@dimen/size_icon_album"
                                android:layout_marginEnd="@dimen/margin_icon_camera"
                                android:src="@drawable/icon_album"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/tx_album"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tx_album"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pretendard_medium"
                                android:text="@string/tx_choose_album"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_btn_capture"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/icon_album"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tx_url_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_url_name"
                    android:fontFamily="@font/pretendard_medium"
                    android:text="@string/tx_url_name"
                    android:textColor="@color/black"
                    android:textSize="@dimen/size_url_name_text"
                    app:layout_constraintStart_toStartOf="@+id/img_url"
                    app:layout_constraintTop_toBottomOf="@+id/linear_change_img" />

                <EditText
                    android:id="@+id/tx_url_name_info"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/height_edt_url_name"
                    android:layout_marginTop="@dimen/margin_top_edt_url_name"
                    android:layout_marginEnd="@dimen/url_detail_img_margin"
                    android:background="@drawable/border_edt_url"
                    android:paddingStart="@dimen/padding_start_edt_url_name"
                    android:paddingEnd="@dimen/padding_start_edt_url_name"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/img_url"
                    app:layout_constraintTop_toBottomOf="@+id/tx_url_name" />

                <TextView
                    android:id="@+id/tx_memo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_memo_text"
                    android:fontFamily="@font/pretendard_medium"
                    android:text="@string/tx_memo"
                    android:textColor="@color/black"
                    android:textSize="@dimen/size_memo_text"
                    app:layout_constraintStart_toStartOf="@+id/img_url"
                    app:layout_constraintTop_toBottomOf="@+id/tx_url_name_info" />

                <EditText
                    android:id="@+id/tx_memo_info"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/height_edt_memo"
                    android:layout_marginTop="@dimen/margin_top_edt_memo"
                    android:background="@drawable/border_edt_url"
                    android:paddingStart="@dimen/padding_start_edt_memo"
                    android:paddingTop="@dimen/padding_top_tx_memo"
                    android:paddingEnd="@dimen/padding_start_edt_memo"
                    android:paddingBottom="@dimen/padding_top_tx_memo"
                    android:gravity="start"
                    android:textColor="@color/black"
                    android:textSize="@dimen/size_tx_url_name"
                    app:layout_constraintEnd_toEndOf="@+id/img_url"
                    app:layout_constraintStart_toStartOf="@+id/img_url"
                    app:layout_constraintTop_toBottomOf="@+id/tx_memo" />

                <LinearLayout
                    android:id="@+id/linear_visit_delete"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_capture_height"
                    android:layout_marginTop="@dimen/margin_top_linear_btn_edit_delete"
                    android:layout_marginBottom="@dimen/btn_capture_margin_bottom"
                    android:gravity="fill_horizontal"
                    android:orientation="horizontal"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/tx_url_name_info"
                    app:layout_constraintStart_toStartOf="@+id/img_url"
                    app:layout_constraintTop_toBottomOf="@+id/tx_memo_info">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_visit"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/btn_capture_height"
                        android:layout_gravity="start"
                        android:layout_marginBottom="@dimen/btn_capture_margin_bottom"
                        android:layout_weight="1"
                        android:background="@drawable/border_btn_delete">

                        <TextView
                            android:id="@+id/textView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_medium"
                            android:text="@string/tx_back"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_btn_capture"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <Space
                        android:layout_width="@dimen/space_margin_between_constraint"
                        android:layout_height="match_parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_delete"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/btn_capture_height"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/btn_capture_margin_bottom"
                        android:layout_weight="1"
                        android:onClick="@{() -> viewmodel.btnSaveChanges()}"
                        android:background="@drawable/border_btn_capture">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_medium"
                            android:text="@string/tx_save"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_btn_capture"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>