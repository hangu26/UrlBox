<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/constraint_url_margin_bottom">

    <LinearLayout
        android:id="@+id/btn_url"
        android:layout_width="match_parent"
        android:layout_height="@dimen/constraint_item_url_height"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_thumbnail"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/img_ex_url" />

        <TextView
            android:id="@+id/tx_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="3"
            android:fontFamily="@font/pretendard_semibold"
            android:paddingStart="@dimen/item_url_padding_side"
            android:paddingEnd="@dimen/item_url_padding_side"
            android:text="https://www.youtube.com/"
            android:textSize="@dimen/tx_save_url_size" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>