<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_url"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/background_item_clip"
        >

        <TextView
            android:id="@+id/tx_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:breakStrategy="simple"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:hyphenationFrequency="none"
            android:paddingStart="@dimen/item_url_padding_side"
            android:paddingEnd="@dimen/item_url_padding_side"
            android:text="https://www.youtube.com/wersadfasdgweardfasdfasgdsag"
            android:textSize="@dimen/tx_confirm_url_size"
            android:textColor="@color/tx_black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="30dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>