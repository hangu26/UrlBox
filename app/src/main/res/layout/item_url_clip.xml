<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_url"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_btn_clip_url"
        android:background="@drawable/background_item_clip_selector"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/ll_copy_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_ll_copy_delete"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ic_clip_copy"
                android:layout_width="@dimen/size_ic_clip_link"
                android:layout_height="@dimen/size_ic_clip_link"
                android:elevation="4dp"
                android:src="@drawable/ic_clip_copy" />

            <Space
                android:layout_width="@dimen/space_ll_copy_delete"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/ic_clip_delete"
                android:layout_width="@dimen/size_ic_clip_link"
                android:layout_height="@dimen/size_ic_clip_link"
                android:src="@drawable/ic_clip_delete" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ic_clip_link"
            android:layout_width="@dimen/size_ic_clip_link"
            android:layout_height="@dimen/size_ic_clip_link"
            android:layout_marginStart="@dimen/margin_start_ic_clip_link"
            android:src="@drawable/ic_clip_link"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ll_copy_delete" />

        <TextView
            android:id="@+id/tx_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:breakStrategy="simple"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:hyphenationFrequency="none"
            android:lines="2"
            android:paddingStart="@dimen/item_url_padding_side"
            android:paddingEnd="@dimen/item_url_padding_side"
            android:text="https://www.youtube.com/wersadfasdgweardfasdfasgdsag"
            android:textColor="@color/tx_black"
            android:textSize="@dimen/tx_confirm_url_size"
            app:layout_constraintBottom_toBottomOf="@+id/ic_clip_link"
            app:layout_constraintEnd_toStartOf="@+id/ll_copy_delete"
            app:layout_constraintStart_toEndOf="@+id/ic_clip_link"
            app:layout_constraintTop_toTopOf="@+id/ic_clip_link" />

        <!-- 하단 액센트 라인 -->
        <View
            android:id="@+id/accent_line"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:background="@drawable/gradient_accent_line"
            android:scaleX="0"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>