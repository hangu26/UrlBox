<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_gradient"
    android:orientation="vertical"
    android:padding="@dimen/bottom_sheet_padding">

    <View
        android:layout_width="@dimen/drag_handle_width"
        android:layout_height="@dimen/drag_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/drag_handle_margin_bottom"
        android:background="@color/color_drag_handle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/img_secret"
            android:layout_width="@dimen/hidden_folder_header_icon_size"
            android:layout_height="@dimen/hidden_folder_header_icon_size"
            android:src="@drawable/ic_secret_bottom_sheet"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tx_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hidden_folder_header_title_margin_start"
            android:fontFamily="@font/pretendard_bold"
            android:text="@string/tx_hidden_folder"
            android:textColor="@color/appBar_title_01"
            android:textSize="@dimen/hidden_folder_title_text_size"
            app:layout_constraintStart_toEndOf="@id/img_secret"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0개의 링크"
            android:textColor="@color/color_hidden_folder_gold_60"
            android:textSize="@dimen/hidden_folder_description_text_size"
            app:layout_constraintStart_toStartOf="@id/tx_title"
            app:layout_constraintTop_toBottomOf="@id/tx_title" />

        <TextView
            android:id="@+id/tvUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hidden_usage_chip"
            android:fontFamily="@font/pretendard_medium"
            android:paddingStart="@dimen/hidden_folder_usage_padding_horizontal"
            android:paddingTop="@dimen/hidden_folder_usage_padding_vertical"
            android:paddingEnd="@dimen/hidden_folder_usage_padding_horizontal"
            android:paddingBottom="@dimen/hidden_folder_usage_padding_vertical"
            android:text="@string/tx_hidden_folder_usage"
            android:layout_marginEnd="@dimen/hidden_folder_header_close_margin_end"
            android:textColor="@color/color_hidden_folder_gold"
            android:textSize="@dimen/hidden_folder_usage_text_size"
            app:layout_constraintBottom_toBottomOf="@id/img_secret"
            app:layout_constraintEnd_toStartOf="@id/btnClose"
            app:layout_constraintTop_toTopOf="@id/img_secret" />

        <FrameLayout
            android:id="@+id/btnClose"
            android:layout_width="@dimen/hidden_folder_header_close_size"
            android:layout_height="@dimen/hidden_folder_header_close_size"
            android:background="@drawable/bg_hidden_close_chip"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="@id/img_secret"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/img_secret">

            <ImageView
                android:layout_width="@dimen/hidden_folder_header_close_icon_size"
                android:layout_height="@dimen/hidden_folder_header_close_icon_size"
                android:layout_gravity="center"
                android:contentDescription="@string/tx_cancel"
                android:src="@drawable/ic_tuto_close" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/hidden_folder_box_margin_top"
        android:background="#33A1824A" />

    <LinearLayout
        android:id="@+id/layoutNoPasswordMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hidden_folder_box_margin_top"
            android:background="@drawable/bg_hidden_folder_box"
            android:padding="@dimen/hidden_folder_box_padding">

            <ImageView
                android:id="@+id/img_secret_password"
                android:layout_width="@dimen/hidden_folder_icon_width"
                android:layout_height="@dimen/hidden_folder_icon_height"
                android:contentDescription="@string/desc_password_icon"
                android:src="@drawable/ic_secret_password"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvNoPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hidden_folder_text_margin_start"
                android:fontFamily="@font/pretendard_bold"
                android:text="@string/tx_no_password"
                android:textColor="@color/color_hidden_folder_gold"
                android:textSize="@dimen/hidden_folder_button_text_size"
                app:layout_constraintStart_toEndOf="@id/img_secret_password"
                app:layout_constraintTop_toTopOf="@id/img_secret_password" />

            <TextView
                android:id="@+id/tvPasswordDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hidden_folder_text_margin_start"
                android:layout_marginTop="@dimen/hidden_folder_text_margin_top"
                android:fontFamily="@font/pretendard_regular"
                android:text="@string/tx_no_password_desc"
                android:textColor="@color/color_hidden_folder_gold_60"
                android:textSize="@dimen/hidden_folder_description_text_size"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/img_secret_password"
                app:layout_constraintTop_toBottomOf="@id/tvNoPassword" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hidden_folder_button_area_margin_top">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnSetPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hidden_folder_button_height"
                android:background="@drawable/bg_btn_set_password"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:text="@string/tx_set_password_now"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/hidden_folder_button_text_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnOpen"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hidden_folder_button_height"
                android:layout_marginTop="@dimen/hidden_folder_button_margin_top"
                android:background="@drawable/bg_btn_open_hidden"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnSetPassword">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:text="@string/tx_open_anyway"
                    android:textColor="@color/color_hidden_folder_gold"
                    android:textSize="@dimen/hidden_folder_button_text_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutPasswordMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hidden_folder_pin_top_margin"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="@dimen/hidden_folder_pin_icon_box_size"
            android:layout_height="@dimen/hidden_folder_pin_icon_box_size"
            android:background="@drawable/bg_hidden_pin_icon_box">

            <ImageView
                android:layout_width="@dimen/hidden_folder_pin_icon_size"
                android:layout_height="@dimen/hidden_folder_pin_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_secret_password" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hidden_folder_pin_title_margin_top"
            android:fontFamily="@font/pretendard_bold"
            android:text="@string/tx_hidden_pin_input"
            android:textColor="@color/color_hidden_folder_gold"
            android:textSize="@dimen/hidden_folder_pin_title_size" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hidden_folder_pin_keypad_extra_margin"
            android:orientation="horizontal">

            <View
                android:id="@+id/pinDot1"
                android:layout_width="@dimen/hidden_folder_pin_dot_size"
                android:layout_height="@dimen/hidden_folder_pin_dot_size"
                android:background="@drawable/bg_hidden_pin_dot_inactive" />

            <View
                android:id="@+id/pinDot2"
                android:layout_width="@dimen/hidden_folder_pin_dot_size"
                android:layout_height="@dimen/hidden_folder_pin_dot_size"
                android:layout_marginStart="@dimen/hidden_folder_pin_dot_spacing"
                android:background="@drawable/bg_hidden_pin_dot_inactive" />

            <View
                android:id="@+id/pinDot3"
                android:layout_width="@dimen/hidden_folder_pin_dot_size"
                android:layout_height="@dimen/hidden_folder_pin_dot_size"
                android:layout_marginStart="@dimen/hidden_folder_pin_dot_spacing"
                android:background="@drawable/bg_hidden_pin_dot_inactive" />

            <View
                android:id="@+id/pinDot4"
                android:layout_width="@dimen/hidden_folder_pin_dot_size"
                android:layout_height="@dimen/hidden_folder_pin_dot_size"
                android:layout_marginStart="@dimen/hidden_folder_pin_dot_spacing"
                android:background="@drawable/bg_hidden_pin_dot_inactive" />
        </LinearLayout>

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hidden_folder_pin_keypad_margin_top"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:rowCount="4"
            android:useDefaultMargins="true">

            <TextView
                android:id="@+id/pinNumber1"
                style="@style/HiddenPinKeyStyle"
                android:text="1" />

            <TextView
                android:id="@+id/pinNumber2"
                style="@style/HiddenPinKeyStyle"
                android:text="2" />

            <TextView
                android:id="@+id/pinNumber3"
                style="@style/HiddenPinKeyStyle"
                android:text="3" />

            <TextView
                android:id="@+id/pinNumber4"
                style="@style/HiddenPinKeyStyle"
                android:text="4" />

            <TextView
                android:id="@+id/pinNumber5"
                style="@style/HiddenPinKeyStyle"
                android:text="5" />

            <TextView
                android:id="@+id/pinNumber6"
                style="@style/HiddenPinKeyStyle"
                android:text="6" />

            <TextView
                android:id="@+id/pinNumber7"
                style="@style/HiddenPinKeyStyle"
                android:text="7" />

            <TextView
                android:id="@+id/pinNumber8"
                style="@style/HiddenPinKeyStyle"
                android:text="8" />

            <TextView
                android:id="@+id/pinNumber9"
                style="@style/HiddenPinKeyStyle"
                android:text="9" />

            <Space
                android:layout_width="@dimen/hidden_folder_pin_key_width"
                android:layout_height="@dimen/hidden_folder_pin_key_height" />

            <TextView
                android:id="@+id/pinNumber0"
                style="@style/HiddenPinKeyStyle"
                android:text="0" />

            <TextView
                android:id="@+id/pinDelete"
                style="@style/HiddenPinKeyStyle"
                android:text="⌫"
                android:textSize="@dimen/hidden_folder_pin_delete_text_size" />
        </GridLayout>

        <TextView
            android:id="@+id/tvForgotPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hidden_folder_pin_forgot_margin_top"
            android:fontFamily="@font/pretendard_regular"
            android:text="@string/tx_hidden_pin_forgot"
            android:textColor="@color/color_hidden_folder_gold_60"
            android:textSize="@dimen/hidden_folder_pin_forgot_size" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardResetConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hidden_folder_reset_card_margin_top"
            android:layout_marginBottom="@dimen/hidden_folder_reset_card_margin_bottom"
            android:visibility="gone"
            app:cardBackgroundColor="#1A8B0000"
            app:cardCornerRadius="@dimen/hidden_folder_reset_card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/hidden_folder_reset_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:text="@string/tx_hidden_pin_reset_title"
                    android:textColor="@color/color_hidden_folder_gold"
                    android:textSize="@dimen/hidden_folder_reset_title_text_size" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hidden_folder_reset_message_margin_top"
                    android:fontFamily="@font/pretendard_regular"
                    android:text="@string/tx_hidden_pin_reset_message"
                    android:textColor="@color/color_hidden_folder_gold_60"
                    android:textSize="@dimen/hidden_folder_reset_message_text_size" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hidden_folder_reset_button_area_margin_top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnResetCancel"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/hidden_folder_reset_button_height"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/hidden_folder_reset_button_margin_end"
                        android:background="@drawable/bg_reset_cancel_button"
                        android:fontFamily="@font/pretendard_semibold"
                        android:gravity="center"
                        android:text="@string/tx_cancel"
                        android:textColor="#C9A86A"
                        android:textSize="@dimen/hidden_folder_reset_button_text_size" />

                    <TextView
                        android:id="@+id/btnResetConfirm"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/hidden_folder_reset_button_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_reset_confirm_button"
                        android:fontFamily="@font/pretendard_semibold"
                        android:gravity="center"
                        android:text="@string/tx_reset"
                        android:textColor="#EF4444"
                        android:textSize="@dimen/hidden_folder_reset_button_text_size" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutUnlockedMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hidden_folder_pin_top_margin"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingBottom="@dimen/hidden_folder_unlocked_bottom_padding">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHiddenUrls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutHiddenEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/hidden_folder_pin_icon_box_size"
                android:layout_height="@dimen/hidden_folder_pin_icon_box_size"
                android:background="@drawable/bg_hidden_pin_icon_box">

                <ImageView
                    android:layout_width="@dimen/hidden_folder_pin_icon_size"
                    android:layout_height="@dimen/hidden_folder_pin_icon_size"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_secret_password"
                    android:tint="@color/color_hidden_folder_gold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/pretendard_bold"
                android:text="@string/tx_hidden_link_empty_title"
                android:textColor="@color/color_hidden_folder_gold"
                android:textSize="@dimen/hidden_folder_pin_title_size" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/pretendard_regular"
                android:text="@string/tx_hidden_link_empty_desc"
                android:textAlignment="center"
                android:textColor="@color/color_hidden_folder_gold_60"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>