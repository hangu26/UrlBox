<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="fragment"
            type="kr.baeksuk.urlbox.view.nav.UrlFragment" />

        <variable
            name="viewModel"
            type="kr.baeksuk.urlbox.viewmodel.nav.UrlViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_tags"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_side_rv_tag"
                android:layout_marginTop="@dimen/margin_top_rv_tag"
                android:layout_marginEnd="@dimen/margin_side_rv_tag"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:listitem="@layout/item_url_tag" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_add_link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_side_cl_add_link"
                android:layout_marginTop="@dimen/margin_top_margin_top_cl_add_link"
                android:layout_marginEnd="@dimen/margin_side_cl_add_link"
                android:background="@drawable/border_cl_add_link"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_tags">

                <TextView
                    android:id="@+id/tx_add_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_start_tx_add_link"
                    android:layout_marginTop="@dimen/margin_top_tx_add_link"
                    android:fontFamily="@font/pretendard_medium"
                    android:text="@string/tx_add_link"
                    android:textColor="@color/appBar_title_02"
                    android:textSize="@dimen/tx_add_link_size"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/ll_add_link"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/edt_url_margin_top"
                    android:layout_marginEnd="@dimen/margin_start_ll_add_link"
                    android:layout_marginBottom="@dimen/margin_bottom_ll_add_link"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tx_add_link"
                    app:layout_constraintTop_toBottomOf="@+id/tx_add_link">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_save_url"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/btn_save_url_height"
                        android:layout_weight="7"
                        android:background="@drawable/border_edt_url">

                        <EditText
                            android:id="@+id/edt_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/tx_save_url_margin_start"
                            android:layout_marginEnd="@dimen/tx_save_url_margin_start"
                            android:background="@null"
                            android:fontFamily="@font/pretendard_light"
                            android:hint="@string/tx_paste_url"
                            android:imeOptions="actionDone"
                            android:inputType="textUri"
                            android:onEditorAction="@{(v, actionId, event) -> viewModel.onUrlInputDone(actionId)}"
                            android:textColor="@color/black"
                            android:textColorHint="@color/appBar_title_02"
                            android:textSize="@dimen/tx_save_url_size"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.5"
                        android:background="@drawable/border_add_link_main"
                        android:onClick="@{() -> viewModel.btnAdd()}">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tx_add"
                            android:textColor="@color/white"
                            android:textSize="@dimen/tx_add_link_size"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tx_saved_url_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_side_in_url_page"
                android:fontFamily="@font/pretendard_semibold"
                android:text="@string/tx_saved_url_list"
                android:textColor="@color/tx_black"
                android:textSize="@dimen/tx_saved_url_list"
                app:layout_constraintBottom_toBottomOf="@+id/ll_view_type"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ll_view_type" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/linear_refresh"
                android:layout_width="@dimen/size_ll_refresh"
                android:layout_height="@dimen/size_ll_refresh"
                android:layout_marginStart="@dimen/margin_start_ll_refresh"
                android:background="@drawable/border_ll_refresh"
                android:onClick="@{() -> viewModel.btnRefresh()}"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@+id/tx_saved_url_list"
                app:layout_constraintStart_toEndOf="@+id/tx_saved_url_list"
                app:layout_constraintTop_toTopOf="@+id/tx_saved_url_list">

                <ImageView
                    android:layout_width="@dimen/size_icon_refresh"
                    android:layout_height="@dimen/size_icon_refresh"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_refresh"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/ll_view_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_bottom_ll_view_type"
                android:background="@drawable/bg_ll_view_type"
                android:elevation="5dp"
                android:orientation="horizontal"
                android:padding="6dp"
                app:layout_constraintBottom_toTopOf="@+id/frameLayout"
                app:layout_constraintEnd_toEndOf="@+id/cl_add_link"
                app:layout_constraintTop_toBottomOf="@+id/cl_add_link">

                <ImageView
                    android:id="@+id/iv_two_type"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_view_type_selector"
                    android:padding="10dp"
                    android:src="@drawable/ic_two_type_selector" />

                <ImageView
                    android:id="@+id/iv_three_type"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_view_type_selector"
                    android:padding="10dp"
                    android:src="@drawable/ic_three_type_selector" />

                <ImageView
                    android:id="@+id/iv_four_type"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_view_type_selector"
                    android:padding="10dp"
                    android:src="@drawable/ic_four_type_selector" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/frameLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/margin_side_frame_layout"
                android:layout_marginTop="@dimen/margin_top_frame_urls"
                android:layout_marginEnd="@dimen/margin_side_frame_layout"
                android:paddingBottom="@dimen/frame_recyclerview_padding_bottom"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_view_type">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_url"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="true"
                    android:scrollbars="none"
                    tools:listitem="@layout/item_url_list" />

            </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/loading_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/appBar_title_02"
                android:scaleY="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewIsLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:text="@string/tx_loading"
                android:textColor="@color/appBar_title_02"
                android:textSize="@dimen/size_tx_loading"
                app:layout_constraintEnd_toEndOf="@id/progressBar"
                app:layout_constraintStart_toStartOf="@id/progressBar"
                app:layout_constraintTop_toBottomOf="@id/progressBar" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/size_btn_add_url"
            android:layout_height="@dimen/size_btn_add_url"
            android:layout_marginEnd="@dimen/margin_end_btn_add_url"
            android:layout_marginBottom="@dimen/margin_bottom_btn_add_url"
            android:onClick="@{() -> viewModel.btnAdd()}"
            android:visibility="gone"
            app:cardBackgroundColor="@color/app_green"
            app:cardCornerRadius="@dimen/radius_border_btn_add_url"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/frameLayout">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="@dimen/size_border_btn_add_url"
                android:layout_height="@dimen/size_border_btn_add_url"
                android:layout_gravity="center"
                android:src="@drawable/add_24px" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

<androidx.constraintlayout.widget.ConstraintLayout
android:id="@+id/skeleton_layout"
android:layout_height="0dp"
android:layout_width="0dp"
android:visibility="gone"
app:layout_constraintBottom_toBottomOf="parent"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toTopOf="parent">

<include layout="@layout/layout_skeleton_ui" />

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/loading_bar_skeleton"
    android:layout_gravity="center_horizontal"
    android:layout_height="wrap_content"
    android:layout_width="wrap_content"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <ProgressBar
        android:id="@+id/progressBar_skeleton"
        android:indeterminateTint="@color/black"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:scaleY="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    </layout>