<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.LinkBox" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowActivityTransitions">true</item>

        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>
    <style name="Theme.LinkBox" parent="Base.Theme.LinkBox" />

    <style name="Theme.LinkBox.ShareReceiver" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ImageButton"> <!-- 이미지 버튼에 대한 스타일 -->
        <item name="android:scaleType">fitCenter</item> <!--ScaleType 요소 중 fitCenter : 이미지가 뷰의 영역을 완전히 채우고 중앙정렬, 비율 유지한다.-->
    </style>

    <style name="ImageButton.size">
        <item name="android:background">@drawable/ripple</item> <!-- 이미지 버튼이 클릭 됐을 때의 대한 처리 -->
        <item name="android:layout_width">@dimen/img_btn_width</item> <!-- 이미지 버튼 크기 -->
        <item name="android:layout_height">@dimen/img_btn_height</item>
    </style>

    <style name="ImageButton.size.icon">
        <item name="android:padding">@dimen/constraint_hand_bottom</item>
    </style>

    <style name="UrlButton"> <!-- 이미지 버튼에 대한 스타일 -->
        <item name="android:scaleType">fitCenter</item> <!--ScaleType 요소 중 fitCenter : 이미지가 뷰의 영역을 완전히 채우고 중앙정렬, 비율 유지한다.-->
    </style>

    <style name="UrlButton.size">
        <item name="android:background">@drawable/ripple</item> <!-- 이미지 버튼이 클릭 됐을 때의 대한 처리 -->
        <item name="android:layout_width">@dimen/img_btn_width</item> <!-- 이미지 버튼 크기 -->
        <item name="android:layout_height">@dimen/img_btn_height</item>
    </style>

</resources>