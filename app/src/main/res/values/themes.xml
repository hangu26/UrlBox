<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.LinkBox" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowActivityTransitions">true</item>

        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>
    <style name="Theme.LinkBox" parent="Base.Theme.LinkBox" />

    <style name="Theme.LinkBox.ShareReceiver" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ImageButton"> <!-- 이미지 버튼에 대한 스타일 -->
        <item name="android:scaleType">fitCenter</item> <!--ScaleType 요소 중 fitCenter : 이미지가 뷰의 영역을 완전히 채우고 중앙정렬, 비율 유지한다.-->
    </style>

    <style name="ImageButton.size">
        <item name="android:background">@drawable/ripple</item> <!-- 이미지 버튼이 클릭 됐을 때의 대한 처리 -->
        <item name="android:layout_width">@dimen/img_btn_width</item> <!-- 이미지 버튼 크기 -->
        <item name="android:layout_height">@dimen/img_btn_height</item>
    </style>

    <style name="ImageButton.size.icon">
        <item name="android:padding">@dimen/constraint_hand_bottom</item>
    </style>

    <style name="UrlButton"> <!-- 이미지 버튼에 대한 스타일 -->
        <item name="android:scaleType">fitCenter</item> <!--ScaleType 요소 중 fitCenter : 이미지가 뷰의 영역을 완전히 채우고 중앙정렬, 비율 유지한다.-->
    </style>

    <style name="UrlButton.size">
        <item name="android:background">@drawable/ripple</item> <!-- 이미지 버튼이 클릭 됐을 때의 대한 처리 -->
        <item name="android:layout_width">@dimen/img_btn_width</item> <!-- 이미지 버튼 크기 -->
        <item name="android:layout_height">@dimen/img_btn_height</item>
    </style>

    <style name="PinKeyStyle">
        <item name="android:layout_width">@dimen/pin_key_width</item>
        <item name="android:layout_height">@dimen/pin_key_height</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_pin_key_button</item>
        <item name="android:textColor">@color/appBar_title_02</item>
        <item name="android:textSize">@dimen/pin_key_text_size</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="HiddenPinKeyStyle">
        <item name="android:layout_width">@dimen/hidden_folder_pin_key_width</item>
        <item name="android:layout_height">@dimen/hidden_folder_pin_key_height</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_hidden_pin_key</item>
        <item name="android:textColor">@color/color_hidden_folder_gold</item>
        <item name="android:textSize">@dimen/hidden_folder_pin_key_text_size</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>